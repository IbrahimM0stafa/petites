# ═══════════════════════════════════════════════════════════════
# Petites — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════

# ── Spring Boot ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=petites
POSTGRES_USER=petites
POSTGRES_PASSWORD=change-me-use-a-strong-password

# ── JPA / Hibernate ───────────────────────────────────────────
# Use "update" for first deploy, then switch to "validate"
DB_DDL_AUTO=update

# ── JWT Authentication ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-secure-64-char-hex-string
JWT_ISSUER=petites-backend
JWT_EXPIRATION_MINUTES=120
JWT_REFRESH_EXPIRATION_DAYS=30

# ── Cloudinary (Image Uploads) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://petites.com,https://admin.petites.com

# ── Port Mapping ──────────────────────────────────────────────
# Host port for the storefront (petites.com)
FRONTEND_PORT=80
# Host port for the admin dashboard (admin.petites.com)
DASHBOARD_PORT=8081

# ── Spring Mail ────────────────────────────────────────────────
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_STARTTLS_ENABLE=false
APP_MAIL_FROM=noreply@petites.com

